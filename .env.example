# ---------------------------------------------------------------------------
# Second Orbit environment.
# Copy to `.env` (never commit it). With nothing set beyond DATABASE_URL every
# integration runs on its local mock, so the whole app works offline.
# Each integration switches to its real SDK (test mode) as soon as its keys
# are present. See README → "Integrations".
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgres://marketplace:marketplace@localhost:54320/marketplace
# Public base URL, used for Stripe/EasyPost redirects, sitemap and canonical URLs.
APP_URL=http://localhost:3000
# Set to 1 to ignore every key below and use mocks (the e2e suite does this).
FORCE_MOCK_INTEGRATIONS=0
# Bearer token for POST /api/cron/release-funds (auto-release after inspection window).
CRON_SECRET=

# --- Marketplace economics (basis points / hours) ---------------------------
PLATFORM_FEE_BPS=800
BUYER_PROTECTION_BPS=300
INSPECTION_WINDOW_HOURS=48

# --- Payments: Stripe Connect (separate charges & transfers) ----------------
# Test-mode keys only: the app refuses to start the Stripe adapter with sk_live_.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` or the dashboard.
STRIPE_WEBHOOK_SECRET=

# --- ID verification: Stripe Identity --------------------------------------
# "stripe" uses Stripe Identity with STRIPE_SECRET_KEY; "mock" forces the mock.
# Leave empty to follow STRIPE_SECRET_KEY.
IDENTITY_PROVIDER=

# --- Shipping: EasyPost ----------------------------------------------------
# Test keys start with EZTK. Test-mode trackers progress automatically.
EASYPOST_API_KEY=
# Webhook secret configured on the EasyPost webhook (HMAC validation).
EASYPOST_WEBHOOK_SECRET=

# --- Storage: any S3-compatible bucket (AWS S3, Cloudflare R2, RustFS) -----
# Leave S3_BUCKET empty to store media on local disk (MEDIA_DIR) served at /media.
S3_BUCKET=
S3_REGION=us-east-1
# Only for non-AWS endpoints, e.g. http://localhost:9000 for the compose RustFS.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=0
# Create the bucket + public-read policy on seed (handy for local RustFS only).
S3_CREATE_BUCKET=0
# Base URL media is served from: CDN domain in production, e.g. https://cdn.example.com
# Defaults to /media (local disk) or the bucket URL.
MEDIA_PUBLIC_URL=
MEDIA_DIR=.data/media

# --- Analytics: Plausible (cookieless, no personal data) -------------------
# Enables the client script and server-side events when set.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# --- Social sign-in: Google, Apple, Facebook --------------------------------
# Each "Continue with …" button appears only when that provider's keys are set.
# Register this redirect URI with every provider (APP_URL must match exactly):
#   ${APP_URL}/api/auth/oauth/google/callback
#   ${APP_URL}/api/auth/oauth/apple/callback      (Apple: HTTPS, no localhost; use a tunnel)
#   ${APP_URL}/api/auth/oauth/facebook/callback
# README → "Social sign-in" explains where to get each value.

# Google Cloud console → APIs & Services → Credentials → OAuth client ID (type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Developer → Certificates, IDs & Profiles.
# APPLE_CLIENT_ID is the *Services ID* (e.g. com.example.secondorbit.web), not the App ID.
APPLE_CLIENT_ID=
# 10-character Team ID (top right of the developer portal).
APPLE_TEAM_ID=
# Key ID of a key with "Sign in with Apple" enabled.
APPLE_KEY_ID=
# Contents of that key's AuthKey_XXXX.p8 file. One line with \n for newlines is fine:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=

# Meta for Developers → your app → Facebook Login. App settings → Basic for the ID and secret.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Graph API version used for the login dialog and profile calls.
FACEBOOK_GRAPH_VERSION=v23.0

# 1 = replace all three with a local simulator (the e2e suite uses this).
# It lets anyone claim any email, so the app refuses to start it unless APP_URL is localhost.
OAUTH_MOCK=0

# --- Email -------------------------------------------------------------------
# Without a key, emails stay in the database and show up at /mock/inbox.
RESEND_API_KEY=
EMAIL_FROM=Second Orbit <hello@second-orbit.example>
SUPPORT_EMAIL=support@second-orbit.example

# --- Two-factor sign-in ------------------------------------------------------
# Encrypts TOTP secrets at rest. Required unless APP_URL is localhost.
TWO_FACTOR_KEY=
# Staff must set up two-factor before the back office opens. Set to 1 to skip
# that, so the shared demo staff accounts work straight away on a local copy.
STAFF_2FA_OPTIONAL=1
